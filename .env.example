# 复制为 .env 后按需填写。不要把真实密钥提交进仓库。
# 默认 dev 档案使用 application-dev.yml 里的公开占位密钥，只能连内存 H2。

# 改用 PostgreSQL 时：
# SPRING_PROFILES_ACTIVE=postgres
# SERVER_PORT=18443
# DATABASE_URL=jdbc:postgresql://localhost:54329/ftcrm
# DATABASE_USER=ftcrm
# DATABASE_PASSWORD=change-me
# CONTACT_VAULT_KEY=
# CONTACT_VAULT_HASH_KEY=
# JWT_SECRET=

# M2 消息骨架不读取这些值去发信。留空即可启动。接通供应商前再填写，不要提交真实密钥。
# WhatsApp 官方 API 占位：360dialog 或 WATI。WHATSAPP_PROVIDER 只允许 360dialog、wati。
# WHATSAPP_PROVIDER=
# WHATSAPP_API_BASE=
# WHATSAPP_API_KEY=
# WATI_API_BASE=
# WATI_API_TOKEN=
# 邮件占位：gmail 或 resend。EMAIL_PROVIDER 只允许 gmail、resend。
# EMAIL_PROVIDER=
# RESEND_API_KEY=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# 每个账号每小时发送上限。超出返回 429，不带联系方式。
# WHATSAPP_SENDS_PER_HOUR=30
# EMAIL_SENDS_PER_HOUR=60

# 前端开发默认走 Vite 代理，不需要设置。
# 若前后端不同源，再设置 VITE_API_BASE=http://127.0.0.1:18443
