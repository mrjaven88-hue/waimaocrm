# 澄远外贸 CRM — 环境变量示例（无真实密钥）
# 复制为 .env 后填写；不要把填好的 .env 提交到版本库。

# --- 服务 ---
SERVER_PORT=18443

# --- 保险库 / JWT（生产必须更换）---
CONTACT_VAULT_KEY=
CONTACT_VAULT_HASH_KEY=
JWT_SECRET=

# --- M2 消息供应商 ---
# EMAIL_PROVIDER / WHATSAPP_PROVIDER 取值：
#   unconfigured  默认。走 stub：HTTP 501，delivered=false，不外呼、不解密。
#   mock          联调/测试。走闸+限流+模板+审计，HTTP 202，delivered=true，provider=mock，不外呼、不解密。
#   resend|smtp|gmail   邮件实发（缺密钥则 503 PROVIDER_NOT_CONFIGURED，错误不回显目的地）
#   wati|360dialog      WhatsApp 实发（同上）

EMAIL_PROVIDER=unconfigured
WHATSAPP_PROVIDER=unconfigured

# 限流（每小时）
EMAIL_SENDS_PER_HOUR=60
WHATSAPP_SENDS_PER_HOUR=30

# 发件人（Resend / SMTP / Gmail 实发必填）
EMAIL_FROM=

# Resend（EMAIL_PROVIDER=resend）
RESEND_API_KEY=

# SMTP（EMAIL_PROVIDER=smtp）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Gmail OAuth 壳（EMAIL_PROVIDER=gmail；密钥齐全仍可能返回尚未接通）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# WATI（WHATSAPP_PROVIDER=wati）
WATI_API_BASE=
WATI_API_TOKEN=

# 通用 WhatsApp HTTP / 360dialog（WHATSAPP_PROVIDER=360dialog）
WHATSAPP_API_BASE=
WHATSAPP_API_KEY=
